{
  "name": "vng-api-lab",
  "version": "1.0.0",
  "description": "VNG API lab — APIs, Schemas en Patterns",
  "packageManager": "pnpm@10.26.0",
  "author": {
    "name": "Joep Meindertsma"
  },
  "scripts": {
    "lint": "spectral lint --fail-severity=error \"apis/**/*.yaml\" \"apis/**/*.yml\" \"patterns/**/*.yaml\" \"patterns/**/*.yml\"",
    "lint:aansluitprofielen": "npx -y @redocly/cli@2.57.0 lint aansluitprofielen/*/*.arazzo.yaml",
    "test:aansluitprofielen": "bash aansluitprofielen/test.sh",
    "convert-xmi": "node scripts/xmi-to-json-schema.js",
    "prep-docs": "pnpm convert-xmi && node scripts/generate-portal-data.js && pnpm respec",
    "respec": "node scripts/generate-respec.js",
    "dev": "pnpm prep-docs && concurrently \"vite\" \"pnpm mock\"",
    "build": "pnpm prep-docs && vite build && cp -R docs apis schemas patterns services bpmn *.md dist/ && pnpm -C mijnoverheid install --frozen-lockfile && pnpm -C mijnoverheid exec tsc -b && pnpm -C mijnoverheid exec vite build --base=/mijnoverheid/ && cp -R mijnoverheid/dist dist/mijnoverheid",
    "serve": "pnpm build && npx serve dist",
    "mock": "node scripts/mock-all.js"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "bpmn-js": "^18.16.1",
    "dagre": "^0.8.5",
    "marked": "^15.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@scalar/cli": "latest",
    "@stoplight/prism-cli": "^5.11.0",
    "@stoplight/spectral-cli": "^6.11.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "http-proxy-middleware": "^3.0.5",
    "js-yaml": "^4.1.1",
    "puppeteer": "^24.38.0",
    "sanitize-html": "^2.17.3",
    "serve": "^14.2.0",
    "vite": "^5.0.0",
    "widdershins": "^4.0.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js",
      "esbuild",
      "puppeteer"
    ]
  }
}
